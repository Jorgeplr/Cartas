# Copia este archivo a `.env` y rellena los valores.
#
#   cp .env.example .env
#
# `.env` está en .gitignore a propósito: contiene secretos que no deben
# viajar al repositorio.

# --- Base de datos ---
# En desarrollo vale cualquier cosa. En producción, algo largo y aleatorio:
#   openssl rand -base64 24
POSTGRES_PASSWORD=postgres

# --- Rails ---
# Firma los JWT de sesión. Quien tenga este valor puede falsificar el token de
# cualquier usuario, así que en producción NUNCA uses el de desarrollo:
#   openssl rand -hex 64
# Si lo cambias, todas las sesiones abiertas caducan.
SECRET_KEY_BASE=desarrollo_local_no_usar_en_produccion_0123456789abcdef

# --- Despliegue ---
# Solo hacen falta en producción (docker-compose.prod.yml).

# Origen desde el que se sirve la web. La API rechaza peticiones de cualquier
# otro origen (CORS), así que tiene que coincidir exactamente con el dominio
# real, protocolo incluido.
WEB_ORIGIN=https://cartas.TU-DOMINIO.com

# URL pública de la API. Vite la incrusta en el bundle EN TIEMPO DE BUILD, no
# al arrancar: si la cambias, hay que reconstruir la imagen del front.
VITE_API_URL=https://api-cartas.TU-DOMINIO.com/api
